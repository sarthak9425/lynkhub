PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/shortlink_biohub
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_12345
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_67890
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Real Email OTP Configuration (Nodemailer / Gmail / SendGrid / Custom SMTP)
# For Gmail: Use smtp.gmail.com, Port 587, and an App Password from Google Account Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="LynkHub Authentication" <your_email@gmail.com>

# Real Mobile SMS OTP Configuration (Twilio Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
